---
export const prerender = false

import PageBaseLayout from "@layouts/PageBaseLayout.astro"
---

<PageBaseLayout title="Showcase">
  <main>
    <header>
      <div class="contained-wrapper">
        <h1>Showcase Page</h1>
      </div>
      <div class="page-description full-width-wrapper is-white">
        <div class="contained-wrapper">
          <h6>
            This page is a showcase of various aspects of the site design and
            styles. It includes examples of font styles, spacing, and components
            that can be reused throughout the project. It's a great way to see
            how the different parts of the site are put together and how they
            can be used to create a cohesive and visually pleasing look.
          </h6>
        </div>
      </div>
    </header>
    <section class="font-styles">
      <h3>Font Styles</h3>
      <div class="grid-wrapper">
        <h1 class="is-label">H1</h1>
        <h1 class="is-text">The quick brown fox</h1>
        <h2 class="is-label">H2</h2>
        <h2 class="is-text">The quick brown fox jumps</h2>
        <h3 class="is-label">H3</h3>
        <h3 class="is-text">The quick brown fox jumps over the</h3>
        <h4 class="is-label">H4</h4>
        <h4 class="is-text">The quick brown fox jumps over the lazy dog</h4>
        <h5 class="is-label">H5</h5>
        <h5 class="is-text">The quick brown fox jumps over the lazy dog</h5>
        <h6 class="is-label">H6</h6>
        <h6 class="is-text">The quick brown fox jumps over the lazy dog</h6>
        <p class="is-label">Body</p>
        <p class="is-text">The quick brown fox jumps over the lazy dog</p>
        <small class="is-label">Body Small</small>
        <small class="is-text"
          >The quick brown fox jumps over the lazy dog</small
        >
      </div>
    </section>
  </main>
</PageBaseLayout>

<style>
  main {
    margin: var(--space-6) 0;
  }

  .contained-wrapper,
  section {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .full-width-wrapper {
    width: 100%;
    padding: var(--space-3) 0;

    &.is-white {
      background-color: var(--color-white);
      color: var(--color-black);
    }
  }

  header {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;

    h1 {
      font-style: italic;
      font-stretch: condensed;
      font-weight: 200;
    }

    .page-description {
      margin-top: var(--space-4);
    }
  }

  section.font-styles {
    margin-top: var(--space-8);

    > h3 {
      text-align: center;
      font-style: italic;
      font-stretch: condensed;
      font-weight: 200;
    }

    .grid-wrapper {
      margin-top: var(--space-6);
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      row-gap: var(--space-2);

      .is-label {
        grid-column: 1 / 3;
      }

      .is-text {
        grid-column: 3 / 13;
      }
    }
  }
</style>
